# --- Telegram ---
TELEGRAM_BOT_TOKEN=replace-me

# Numeric Telegram user id of the sole owner. If unset, the bot accepts any
# user (dev convenience). Always set this in production.
# OWNER_TELEGRAM_USER_ID=123456789

# --- Gemini ---
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-2.5-flash

# --- Database (asyncpg URL) ---
# Render injects DATABASE_URL automatically as `postgresql://...`; the app
# normalizes it to `postgresql+asyncpg://...` at load time.
DATABASE_URL=postgresql+asyncpg://prometheus:prometheus@localhost:5432/prometheus

# --- Webhook (prod only) ---
# In dev (ENV=dev), the bot uses long-polling and these are ignored.
# In prod (ENV=prod), set WEBHOOK_URL to your public Render URL, e.g.
# https://prometheus.onrender.com — the bot will POST updates to
# {WEBHOOK_URL}/webhook/{WEBHOOK_SECRET}.
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- Runtime ---
ENV=dev
LOG_LEVEL=INFO
PORT=8080
